# Database
DATABASE_URL=sqlite+aiosqlite:///./trading_detector.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Binance (optional for public endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Scanner
SCAN_INTERVAL_MINUTES=5
